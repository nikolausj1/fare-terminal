# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite data — real.db is the production real-data artifact (see
# docs/RUNBOOK.md's "Real data operations" section): everything else in
# data/ (the demo DB, -wal/-shm sidecars for either DB) stays ignored, but
# data/real.db itself is trackable so the real-data-refresh Action can
# commit it. This does NOT stage it automatically — the lead decides when
# the first real DB lands in git (the production cutover moment).
data/*
!data/real.db

# test artifacts
/test-results/
/playwright-report/

# repo-local scratch (present if these ever land inside the app dir;
# today they live one level up, outside this repo, per WP1 spec)
_inbox/
_review/
Project Build Guide.md
.github/workflows/
